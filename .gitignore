# Internal planning documents
docs/*
# ! Re-include the directories themselves — git cannot re-include files when a
# ! parent directory is excluded (`docs/*` matches the directory entry).
!docs/adr/
!docs/adr/*.md
!docs/architecture/
!docs/architecture/*.md

# Agent assistant state (personal skills, session recovery) — not part of the project
.kilo/

# Local environment
.env
.env.*
!.env.example

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Build artifacts — note: emitted *.config.js next to a *.config.ts would SHADOW the
# real config (Vite loads .js first). tsconfig.json sets noEmit to prevent emission;
# these files are deliberately NOT gitignored so an accidental re-emission is visible.
tsconfig.node.tsbuildinfo
*.tsbuildinfo
.tsbuild-node/

# Editor directories and files
.vscode/*
!.vscode/redirect-rules.code-workspace
!.vscode/tasks.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Playwright
playwright-report/
test-results/
.playwright/
